PROTONMAIL_USERNAME=user@proton.me
PROTONMAIL_PASSWORD=bridge-generated-password
# PROTONMAIL_IMAP_PORT=1143   (default)
# PROTONMAIL_IMAP_HOST=127.0.0.1   (default; only this computer is accepted)
#
# Optional: limit which folders/labels can be read (comma-separated, exact names
# as shown by list_mailboxes). Leave unset to allow every folder.
# PROTONMAIL_ALLOWED_MAILBOXES=Labels/Claude
